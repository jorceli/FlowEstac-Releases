{
  "name": "flowestac-desktop",
  "version": "1.1.1",
  "description": "FlowEstac - Sistema de Estacionamento Desktop",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "start": "npm run build:renderer && electron .",
    "build": "npm run build:renderer && electron-builder"
  },
  "keywords": [],
  "author": "Jorceli Danielli",
  "license": "ISC",
  "dependencies": {
    "electron-pos-printer": "^1.3.8",
    "electron-updater": "^6.1.1",
    "escpos": "^3.0.0-alpha.6",
    "escpos-usb": "^3.0.0-alpha.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "usb": "^2.16.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.20",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "esbuild": "^0.21.5",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.0.0"
  },
  "build": {
    "appId": "com.flowestac.app",
    "productName": "FlowEstac",
    "publish": [
      {
        "provider": "github",
        "owner": "jorceli",
        "repo": "FlowEstac"
      }
    ],
    "asar": false,
    "files": [
      "**/*",
      "!**/*.ts",
      "!*.ts",
      "!src/**/*",
      "!.env.local",
      "!.gitignore",
      "!README.md"
    ],
    "asarUnpack": [
      "node_modules/electron-pos-printer/**/*",
      "node_modules/usb/**/*",
      "node_modules/escpos/**/*",
      "node_modules/escpos-usb/**/*"
    ],
    "directories": {
      "output": "dist",
      "app": "."
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "publisherName": "Jorceli Danielli"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    }
  }
}